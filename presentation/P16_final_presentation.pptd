version: v2
title: P16 — Wildlife Detection in Camera-Trap Images
size: [960, 540]
theme:
  colors:
    primary: "#1F6F43"
    accent: "#E8A33D"
    text: "#1A1A1A"
    muted: "#5A6672"
    light: "#F2F6F3"
  textStyles:
    title:
      fontSize: 30
      color: "$text"
      bold: true
      fontFamily: Arial
    h2:
      fontSize: 17
      color: "$primary"
      bold: true
      fontFamily: Arial
    body:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.35
      fontFamily: Arial
    small:
      fontSize: 10.5
      color: "$muted"
      lineHeight: 1.3
      fontFamily: Arial
  tableStyles:
    results:
      cellStyle:
        fontSize: 11
        fontFamily: Arial
        border: null
        align: [center, middle]
      firstRowStyle:
        bold: true
        color: "#FFFFFF"
        fill: {type: solid, color: "$primary"}
        border: null
      lastRowStyle:
        bold: true
        fill: {type: solid, color: "#E4EFE8"}
        border: null
      bodyStyles:
        - {fill: {type: solid, color: "#FFFFFF"}}
        - {fill: {type: solid, color: "$light"}}
pages:
  - pages/1_problem.page
  - pages/2_results.page
  - pages/3_failures.page
